class Budget:
    budget_history = {
        "Income": [], "Income Source": [], "Income Date": [], "Expense": [], "Expense Category": [], "Expense Date": []
    }
    def __init__(self, balance):
        self.balance = balance

    def add_balance(self, amount, source = "", date = ""):
        self.balance += amount
        self.budget_history["Income"].append(self.balance)
        self.budget_history["Income Source"].append(source)
        self.budget_history["Income Date"].append(date)

    def add_expense(self, amount, category, date):
        self.balance -= amount
        self.budget_history["Expense"].append(amount)
        self.budget_history["Expense Category"].append(category)
        self.budget_history["Expense Date"].append(date)

    def get_remaining_balance(self):
        return self.balance

    def expense_history(self):
        return self.budget_history["Expense"], self.budget_history["Expense Category"], self.budget_history["Expense Date"]

    def income_history(self):
        return self.budget_history["Income"], self.budget_history["Income Source"], self.budget_history["Income Date"]

user = Budget(0)

for i in user.income_history():
    print(",".join(map(str, i)))
