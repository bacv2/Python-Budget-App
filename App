import datetime

class Budget:
    def __init__(self, balance=0 ):
        self.balance = balance
        self.transactions = []

    @staticmethod
    def _now():
        return datetime.datetime.now()

    @staticmethod
    def _dfmt(date):
        return date.strftime("%I:%M:%S %p %m-%d-%Y")
    
    def add_balance(self, amount, source = "Unspecified"):
        self.balance += amount
        self.transactions.append({
            "type": "income",
            "amount": amount,
            "source": source,
            "date": self._now(),
        })

    def add_expense(self, amount, category):
        self.balance -= abs(amount)
        self.transactions.append({
            "type": "expense",
            "amount": amount,
            "category": category,
            "date": self._now()
        })

    def get_remaining_balance(self):
        return self.balance

    def expense_history(self):
        return [f'Expense, {t["category"]}, {t["amount"]}, {self._dfmt(t["date"])}' for t in self.transactions if t["type"] == "expense"] 

    def income_history(self):
        return [f'Income, {t["amount"]}, {t["source"]}, {self._dfmt(t["date"])}' for t in self.transactions if t["type"] == "income"] 

user = Budget(0)
user.add_balance(1000, "Salary")
user.add_expense(200, "Groceries")

print(user.get_remaining_balance())
print(user.income_history())
print(user.expense_history())
